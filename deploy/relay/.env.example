# Copy to an operator-protected file outside the repository. This file contains
# non-secret examples only. The packaging check rejects a deployable env file
# until HOSTD_RELAY_IMAGE contains a real immutable sha256 digest.
HOSTD_RELAY_IMAGE=registry.example.invalid/hostd/rig-relay@sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
HOSTD_RELAY_PUBLIC_BASE_URL=https://relay.example.com
HOSTD_RELAY_GITHUB_CLIENT_ID=replace-with-github-app-client-id
HOSTD_RELAY_GITHUB_APP_ID=123456
HOSTD_RELAY_TLS_SERVER_NAME=relay-backend.example.com
HOSTD_RELAY_EDGE_NETWORK=rig-relay-edge
HOSTD_RELAY_SECRET_DIRECTORY=/etc/rig-relay/secrets
HOSTD_RELAY_PUBLISH_ADDRESS=127.0.0.1
HOSTD_RELAY_PUBLISH_PORT=7346
